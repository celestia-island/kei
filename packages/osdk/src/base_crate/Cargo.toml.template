[workspace]

# An empty workspace table keeps the base crate away from nesting in other
# workspaces.
[package]
name = "#NAME#"
version = "#VERSION#"
edition = "2024"

[patch.crates-io]
ostd = { path = "#OSTD_PATCH_ROOT#/packages/ostd" }
ostd-pod = { path = "#OSTD_PATCH_ROOT#/packages/ostd/libs/ostd-pod" }
ostd-macros = { path = "#OSTD_PATCH_ROOT#/packages/ostd/libs/ostd-macros" }
ostd-test = { path = "#OSTD_PATCH_ROOT#/packages/ostd/libs/ostd-test" }
# The root workspace patches x86_64 to drop the Step forward/backward_overflowing
# impls (incompatible with the pinned nightly); the base crate must apply the
# same patch or the x86_64 build fails with E0407.
x86_64 = { path = "#OSTD_PATCH_ROOT#/packages/patches/x86_64" }

[profile.release]
lto = false
panic = "unwind"

[profile.dev]
panic = "unwind"

[profile.release-lto]
inherits = "release"
lto = true
panic = "abort"
codegen-units = 1
